{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAI Harness",
  "version": "0.1.0",
  "identifier": "dev.smykla.sai-harness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "SAI Harness", "width": 1280, "height": 850, "minWidth": 960, "minHeight": 680 }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
