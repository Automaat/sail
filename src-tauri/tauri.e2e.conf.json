{
  "build": {
    "beforeBuildCommand": "npm run build -- --mode e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "e2e",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:allow-open",
            "dialog:allow-ask",
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  }
}
