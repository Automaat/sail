{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main desktop window",
  "windows": ["main"],
  "permissions": [
    "allow-start-runtime",
    "allow-validate-repository",
    "allow-working-tree-diff",
    "allow-create-worktree",
    "allow-local-plugin-version",
    "allow-acp-agents",
    "allow-acp-connect",
    "allow-acp-new-session",
    "allow-acp-load-session",
    "allow-acp-prompt",
    "allow-acp-cancel",
    "allow-acp-permission",
    "allow-acp-pending-permissions",
    "allow-acp-set-config",
    "allow-acp-authenticate",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-open",
    "dialog:allow-message"
  ]
}
