{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main desktop window",
  "windows": ["main"],
  "permissions": [
    "allow-start-runtime",
    "allow-validate-repository",
    "allow-create-worktree",
    "allow-local-plugin-version",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-open",
    "dialog:allow-message"
  ]
}
